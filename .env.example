CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=commonwealth

# PayDunya (paiement parent Wave / Orange Money / Wizall / MTN / Moov)
# Sandbox : https://app.paydunya.com/sandbox-api/v1  + clés test_
# Live    : https://app.paydunya.com/api/v1          + clés live_
PAYDUNYA_API_BASE=https://app.paydunya.com/sandbox-api/v1
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_STORE_NAME=COMMONWEALTH
# URL HTTPS publique du backend, ex. https://votre-api.onrender.com/api/payments/paydunya/ipn
PAYDUNYA_CALLBACK_URL=

# Liens dans les e-mails (sans ces variables : https://www.commonwealth-school.com/…)
# ADMIN_PORTAL_LOGIN_URL=https://www.commonwealth-school.com/admin/login
# PARENT_PORTAL_LOGIN_URL=https://www.commonwealth-school.com/parent/login

